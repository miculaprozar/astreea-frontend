{
  "expo": {
    "name": "Astreea Charger",
    "slug": "astreea",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/astreealogo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "astreea.charger.app",
      "buildNumber": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/astreealogo.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "digitalgarden.astreea.app",
      "versionCode": 1
    },
    "sdkVersion": "45.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d827e86d-b778-487a-975d-dbaf9a247266"
      }
    },
    "plugins": [
      "react-native-wifi-reborn"
    ]
  }
}